{
  "kind": "collectionType",
  "collectionName": "requests",
  "info": {
    "singularName": "request",
    "pluralName": "requests",
    "displayName": "request"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "offerSkill": {
      "type": "string"
    },
    "wantSkill": {
      "type": "string"
    },
    "message": {
      "type": "text"
    },
    "requestStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "accepted",
        "rejected"
      ]
    },
    "sender": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "mappedBy": "sentRequests"
    },
    "receiver": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "mappedBy": "receivedRequests"
    }
  }
}
